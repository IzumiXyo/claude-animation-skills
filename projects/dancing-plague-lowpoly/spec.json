{
  "duration": 70.8,
  "caps": [
    { "t0": 0.45, "t1": 2.36, "text": "Pada tahun 1518," },
    { "t0": 2.70, "t1": 5.85, "text": "sebuah kejadian aneh<br>terjadi di Strasbourg, Eropa" },
    { "t0": 6.33, "t1": 9.73, "text": "seorang wanita mulai menari<br>sendirian di tengah jalan" },
    { "t0": 10.27, "t1": 11.00, "text": "tanpa musik." },
    { "t0": 11.35, "t1": 12.13, "text": "tanpa pesta." },
    { "t0": 12.62, "t1": 13.96, "text": "ia hanya terus menari." },
    { "t0": 14.44, "t1": 17.40, "text": "sesuatu yang jauh lebih aneh<br>mulai terjadi" },
    { "t0": 18.03, "t1": 19.33, "text": "orang-orang lain<br>ikut menari" },
    { "t0": 19.75, "t1": 22.35, "text": "satu demi satu,<br>jumlahnya bertambah" },
    { "t0": 22.35, "t1": 25.77, "text": "puluhan... ratusan orang" },
    { "t0": 26.25, "t1": 27.44, "text": "yang membuatnya mengerikan" },
    { "t0": 27.75, "t1": 29.57, "text": "mereka tidak bisa berhenti" },
    { "t0": 30.20, "t1": 34.50, "text": "berhari-hari mereka menari" },
    { "t0": 34.86, "t1": 36.38, "text": "meski tubuh kelelahan" },
    { "t0": 36.80, "t1": 41.96, "text": "pemerintah mengira<br>mereka harus terus menari" },
    { "t0": 42.52, "t1": 45.44, "text": "jadi mereka menyiapkan<br>panggung dan musik" },
    { "t0": 45.89, "t1": 49.09, "text": "tapi solusi itu gagal" },
    { "t0": 49.46, "t1": 54.50, "text": "dikenal sebagai<br>Dancing Plague of 1518" },
    { "t0": 54.81, "t1": 58.00, "text": "para sejarawan masih<br>bertanya-tanya" },
    { "t0": 58.54, "t1": 61.75, "text": "jamur? histeria massal?" },
    { "t0": 62.11, "t1": 63.23, "text": "dan bagian paling anehnya?" },
    { "t0": 63.75, "t1": 66.70, "text": "tidak ada yang tahu<br>mengapa mereka menari" }
  ]
}
